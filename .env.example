# Valores somente para desenvolvimento local; gere novos segredos para produção.
POSTGRES_USER=eco
POSTGRES_PASSWORD=eco_dev_password
POSTGRES_DB=eco
IP_HASH_SECRET=local-dev-change-this-with-a-long-random-secret
ADMIN_COOKIE_SECURE=false
# Fora de localhost, use HTTPS e ADMIN_COOKIE_SECURE=true.
WEB_PORT=8080
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Para deploy separado do frontend, use URL absoluta (e configure CORS na API)
API_BASE_URL=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
